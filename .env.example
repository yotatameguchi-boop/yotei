# Google Calendar（Client ID のみ必要）
# Google Cloud Console で OAuth 2.0 クライアント ID（Web）を作成し、
# 承認済み JavaScript 生成元 にアプリ URL を追加してください。
# Client Secret は不要です。
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# 任意（未設定時は自動生成）
AUTH_SECRET=

# 本番 URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# データベース（ローカルは ./data/yotei.db を自動使用）
# 本番（Vercel）では Turso を推奨
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=your-token
